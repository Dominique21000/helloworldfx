<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>fr.dominiquesauvignon</groupId>
	<artifactId>helloworldfx</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>helloworldfx</name>

	<!-- 1. PROPRIÉTÉS CENTRALES -->
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<!-- Version unique à modifier ici si besoin -->
		<javafx.version>21</javafx.version>
		<!-- Variable vide par défaut, remplie par les profils -->
		<javafx.classifier></javafx.classifier>
	</properties>

	<!-- 2. DÉPENDANCES (Utilisent les variables ci-dessus) -->
	<dependencies>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
			<classifier>${javafx.classifier}</classifier>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-fxml</artifactId>
			<version>${javafx.version}</version>
			<classifier>${javafx.classifier}</classifier>
		</dependency>
		<!-- javafx-graphics est souvent transitif, mais explicite est plus sûr -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-graphics</artifactId>
			<version>${javafx.version}</version>
			<classifier>${javafx.classifier}</classifier>
		</dependency>
	</dependencies>

	<!-- 3. BUILD & PLUGINS -->
	<build>
		<plugins>
			<!-- Plugin de compilation standard -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<source>21</source>
					<target>21</target>
				</configuration>
			</plugin>

			<!-- Plugin Officiel JavaFX pour l'exécution -->
			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>0.0.8</version>
				<configuration>
					<mainClass>fr.dominiquesauvignon.helloworldfx.MainApp</mainClass>
					<options>
						<option>--add-modules</option>
						<option>javafx.controls,javafx.fxml</option>
						<option>--enable-native-access</option>
						<option>javafx.graphics</option>
					</options>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- 4. PROFILS OS (La clé de la portabilité) -->
	<profiles>
		<!-- Profil Windows -->
		<profile>
			<id>windows</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<properties>
				<javafx.classifier>win</javafx.classifier>
			</properties>
		</profile>

		<!-- Profil Linux -->
		<profile>
			<id>linux</id>
			<activation>
				<os>
					<family>unix</family>
				</os>
			</activation>
			<properties>
				<javafx.classifier>linux</javafx.classifier>
			</properties>
		</profile>

		<!-- Profil macOS -->
		<profile>
			<id>mac</id>
			<activation>
				<os>
					<family>mac</family>
				</os>
			</activation>
			<properties>
				<javafx.classifier>mac</javafx.classifier>
			</properties>
		</profile>
	</profiles>
</project>